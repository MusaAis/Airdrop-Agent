# Airdrop Agent Configuration
# Copy to .env and fill in all values

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string
MASTER_PASSWORD=your-strong-master-password-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./airdrop.db

# --- AI APIs ---
GROQ_API_KEY=sk-...
GEMINI_API_KEY=...
AI_MAX_TOKENS=4096

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_ALLOWED_USER_IDS=["123456789"]

# --- Oracle Cloud (Object Storage backup) ---
OCI_CONFIG_FILE=~/.oci/config
OCI_BUCKET_NAME=airdrop-backups
OCI_NAMESPACE=your-namespace

# --- Security ---
# IP whitelist (comma-separated CIDR or single IPs)
ALLOWED_IPS=127.0.0.1,::1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Worker & RAM ---
MAX_WORKER_SLOTS=4
MEMORY_ALERT_THRESHOLD_PCT=82

# --- Other ---
LOG_LEVEL=INFO
BACKUP_SCHEDULE_HOUR=3          # UTC hour for nightly backup
DRY_RUN_MODE=false
