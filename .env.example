# Airdrop Agent Configuration
# Copy to .env and fill in all values

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8002
# REQUIRED. The server refuses to start if these are empty, short or still the placeholders.
# SECRET_KEY: >= 32 chars. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   (rotating it only signs everyone out)
SECRET_KEY=change-me-to-a-random-64-char-string
# MASTER_PASSWORD: admin login password AND the key that encrypts imported private keys and the
#   master seed. >= 8 chars required, >= 12 recommended. Do NOT change it after wallets/seed are
#   stored unless you re-encrypt them. The admin account is created from it on first start only.
MASTER_PASSWORD=your-strong-master-password-here
# Local throwaway development ONLY (disables the startup refusal, logs loudly):
# ALLOW_INSECURE_SECRETS=false
DEVICE_TRUST_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./airdrop.db

# --- AI APIs ---
GROQ_API_KEY=sk-...
GEMINI_API_KEY=...
# Optional: comma-separated lists enable key rotation on rate limits (take priority over the single key)
# GROQ_API_KEYS=key1,key2
# GEMINI_API_KEYS=key1,key2

# Optional CoinGecko key for higher price-lookup limits
# COINGECKO_API_KEY=
AI_MAX_TOKENS=4096

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_ALLOWED_USER_IDS=["123456789"]

# --- Security ---
# IP whitelist (comma-separated CIDR or single IPs)
ALLOWED_IPS=127.0.0.1,::1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Worker & RAM ---
MAX_WORKER_SLOTS=4
MEMORY_ALERT_THRESHOLD_PCT=82

# --- Other ---
LOG_LEVEL=INFO
DRY_RUN_MODE=false
